# LLM Provider: gemini, groq, or ollama
LLM_PROVIDER=ollama

# Google Gemini (free tier - 15 RPM)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Groq (free tier)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# PostgreSQL
DATABASE_URL=postgresql://contexthub:contexthub@127.0.0.1:5433/contexthub
DATABASE_URL_READONLY=postgresql://contexthub_readonly:contexthub@127.0.0.1:5433/contexthub

# App
LOG_LEVEL=INFO
